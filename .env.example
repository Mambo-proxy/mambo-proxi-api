# ─── Exemple de configuration — copier en .env et adapter. Aucun secret réel ici. ───
# Les variables sont validées au démarrage : l'API refuse de démarrer si une valeur obligatoire manque.

# Environnement : development | test | production
NODE_ENV=development
# Environnement du site : production | preproduction | development (préproduction = robots bloqués)
SITE_ENV=development
PORT=4000

# URL publique de l'API et du site (CORS, liens des e-mails, revalidation)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Base de données PostgreSQL (voir docker-compose.yml)
DATABASE_URL=postgresql://mambo:mambo@localhost:5432/mambo_proxi?schema=public

# Redis (files d'attente BullMQ)
REDIS_URL=redis://localhost:6379

# Stockage objet compatible S3 (SeaweedFS en local ; Scaleway, OVH, AWS… en production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=fr-par
S3_ACCESS_KEY=mambo-dev-access
S3_SECRET_KEY=mambo-dev-secret-change-me
S3_BUCKET_PUBLIC=mambo-public
S3_BUCKET_PRIVATE=mambo-private
S3_FORCE_PATH_STYLE=true
# Médias publics (images de la médiathèque) : fichiers et variantes AVIF/WebP dans MEDIA_STORAGE_DIR (répertoire
# distinct de STORAGE_DIR), servis par GET /v1/media/{dossier}/{fichier} avec un cache d'un an immuable.
# MEDIA_PUBLIC_URL = adresse publique de cette route (ou d'un CDN placé devant l'API).
MEDIA_PUBLIC_URL=http://localhost:4000/v1/media
MEDIA_STORAGE_DIR=var/media

# Fichiers privés (CV, pièces jointes des demandes) : jamais servis statiquement, téléchargés par lien signé de
# 5 min (GET /v1/files/{token}). Pilote : local (disque) ; STORAGE_DIR = répertoire de stockage, hors de tout
# dossier servi (en recette et en production : volume monté, ex. /srv/mambo-proxi/storage).
STORAGE_DRIVER=local
STORAGE_DIR=var/storage

# Sauvegarde quotidienne de la base (tâche planifiée du worker à 2 h, heure de Douala ; `pnpm db:backup` à la main) :
# fichiers pg_dump (format personnalisé, restauration par pg_restore) dans BACKUP_DIR, rotation 30 jours.
# PG_DUMP_PATH = commande ou chemin de pg_dump (outils clients PostgreSQL de la même version majeure que le serveur).
# Copie vers un stockage objet : à faire hors de l'API (ex. rclone ou aws s3 sync planifié sur le serveur).
BACKUP_DIR=var/backups
PG_DUMP_PATH=pg_dump

# E-mails (Mailpit en local : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MAMBO Proxi <contact@mamboproxi.com>"
# Worker d'envoi des e-mails (file BullMQ `mail`) dans ce processus : on | off (off par défaut en test ;
# en production, possible de le passer à off sur les instances qui ne doivent pas envoyer)
# MAIL_WORKER=on

# Sécurité — générer des valeurs longues et aléatoires (ex. openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
TOKEN_SIGNING_SECRET=change-me-token-secret-at-least-32-characters
# Domaine des cookies partagé site/API (ex. .mamboproxi.com en production, vide en local)
COOKIE_DOMAIN=

# Revalidation du site Next.js (secret partagé avec mambo-proxi-web) : le worker appelle POST {WEB_URL}/api/revalidate
# avec « Authorization: Bearer REVALIDATE_SECRET » (même valeur côté site)
REVALIDATE_SECRET=change-me-revalidate-secret

# Cloudflare Turnstile (clé secrète ; la clé de test ci-dessous valide toujours)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Compte administrateur initial (créé par le seed s'il n'existe pas ; mot de passe haché en argon2id, défini
# seulement s'il n'en a pas encore — en production, une valeur longue et aléatoire, à changer après la connexion)
SEED_ADMIN_EMAIL=mireille@mamboproxi.com
SEED_ADMIN_NAME=Mireille Bell
SEED_ADMIN_PASSWORD=change-me-on-first-login
# Mot de passe commun des comptes de démonstration (Équipe Douala, Carine Eboa, Paul Ngando, Grace Nkongo) :
# développement et tests uniquement, 12 caractères minimum ; vide = comptes sans mot de passe. Interdit en production.
SEED_DEMO_PASSWORD=change-me-demo-password

# Observabilité (facultatif)
SENTRY_DSN=
LOG_LEVEL=info
