# ─── Exemple de configuration — copier en .env et adapter. Aucun secret réel ici. ───
# Les variables sont validées au démarrage : l'API refuse de démarrer si une valeur obligatoire manque.

# Environnement : development | test | production
NODE_ENV=development
# Environnement du site : production | preproduction | development (préproduction = robots bloqués)
SITE_ENV=development
PORT=4000

# URL publique de l'API et du site (CORS, liens des e-mails, revalidation)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Base de données PostgreSQL (voir docker-compose.yml)
DATABASE_URL=postgresql://mambo:mambo@localhost:5432/mambo_proxi?schema=public

# Redis (files d'attente BullMQ)
REDIS_URL=redis://localhost:6379

# Stockage objet compatible S3 (SeaweedFS en local ; Scaleway, OVH, AWS… en production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=fr-par
S3_ACCESS_KEY=mambo-dev-access
S3_SECRET_KEY=mambo-dev-secret-change-me
S3_BUCKET_PUBLIC=mambo-public
S3_BUCKET_PRIVATE=mambo-private
S3_FORCE_PATH_STYLE=true
# URL publique des médias (CDN ou bucket public)
MEDIA_PUBLIC_URL=http://localhost:8333/mambo-public

# E-mails (Mailpit en local : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MAMBO Proxi <contact@mamboproxi.com>"

# Sécurité — générer des valeurs longues et aléatoires (ex. openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
TOKEN_SIGNING_SECRET=change-me-token-secret-at-least-32-characters
# Domaine des cookies partagé site/API (ex. .mamboproxi.com en production, vide en local)
COOKIE_DOMAIN=

# Revalidation du site Next.js (secret partagé avec mambo-proxi-web)
REVALIDATE_SECRET=change-me-revalidate-secret

# Cloudflare Turnstile (clé secrète ; la clé de test ci-dessous valide toujours)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Compte administrateur initial (créé par le seed s'il n'existe pas)
SEED_ADMIN_EMAIL=mireille@mamboproxi.com
SEED_ADMIN_NAME=Mireille Bell
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Observabilité (facultatif)
SENTRY_DSN=
LOG_LEVEL=info
