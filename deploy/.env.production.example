# ─── Configuration de production — à copier en /opt/mambo/.env sur le serveur (jamais dans le dépôt). ───
# Lue par docker compose (interpolation de docker-compose.prod.yml) et passée au conteneur de l'API.
# Secrets : openssl rand -hex 32 (hexadécimal : aucun caractère à échapper dans les adresses de connexion).
# L'API refuse de démarrer si une valeur manque ou garde une valeur d'exemple (« change-me »).

# ── Serveur, HTTPS (Caddy) ──
# Nom d'hôte de l'API : adresse IP élastique avec des tirets + .sslip.io, en attendant un vrai domaine.
API_DOMAIN=13-38-208-248.sslip.io
# Adresse de contact Let's Encrypt (avis d'expiration des certificats).
ACME_EMAIL=
# Mot de passe de l'utilisateur PostgreSQL « mambo » (openssl rand -hex 32). Ne plus le changer une fois la base
# créée (il est enregistré dans le volume postgres-data).
POSTGRES_PASSWORD=

# ── Valeurs posées par docker-compose.prod.yml (ne pas les définir ici) ──
# NODE_ENV=production
# API_URL=https://${API_DOMAIN}
# DATABASE_URL=postgresql://mambo:${POSTGRES_PASSWORD}@postgres:5432/mambo_proxi?schema=public
# REDIS_URL=redis://redis:6379
# MAIL_WORKER=on                  (API et workers dans le même conteneur)
# PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump   (posé par l'image)
# Facultatif : adresse publique des médias (défaut https://${API_DOMAIN}/v1/media ; un CDN placé devant l'API).
# MEDIA_PUBLIC_URL=

# preproduction tant que le site public n'est pas ouvert (clé d'essai Turnstile admise) ; production ensuite.
SITE_ENV=production
PORT=4000
LOG_LEVEL=info

# ── Site (mambo-proxi-web) ──
# Adresse du site public et du back-office, en https (obligatoire en production). Elle sert :
#   - d'origine CORS unique : un navigateur sur une autre adresse ne peut pas appeler l'API avec ses cookies ;
#   - de base des liens des e-mails (connexion, réinitialisation, désinscription…) et du logo des e-mails ;
#   - de cible de la revalidation (POST {WEB_URL}/api/revalidate) : tant que le site n'est pas en ligne, ces appels
#     échouent et sont réessayés puis abandonnés (journalisé, sans effet sur l'API).
# À remplir avec l'adresse réelle dès que le site est déployé (ex. https://mamboproxi.com).
WEB_URL=https://site-a-renseigner.example
# Secret partagé avec le site (même valeur que REVALIDATE_SECRET côté mambo-proxi-web), 16 caractères au moins.
REVALIDATE_SECRET=

# ── Cookies du back-office ──
# Vide tant que site et API n'ont pas de domaine commun. Avec api.mamboproxi.com et mamboproxi.com : .mamboproxi.com
# (cookies SameSite=Lax : le back-office ne fonctionne que si site et API sont sur le même site, voir DEPLOIEMENT.md).
COOKIE_DOMAIN=

# ── Secrets des jetons (openssl rand -hex 32, trois valeurs différentes) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_SIGNING_SECRET=

# ── Anti-spam Cloudflare Turnstile (clé secrète du site ; la clé d'essai 1x0000000000000000000000000000000AA
#    n'est admise qu'avec SITE_ENV=preproduction) ──
TURNSTILE_SECRET_KEY=

# ── Fichiers (volumes docker : storage, media, backups) ──
STORAGE_DRIVER=local
STORAGE_DIR=var/storage
MEDIA_STORAGE_DIR=var/media
BACKUP_DIR=var/backups

# ── Stockage objet S3 : non utilisé pour l'instant (pilote local), mais exigé par la validation. ──
# Valeurs neutres sans « change-me » ; à remplacer quand un pilote S3 sera branché.
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_REGION=eu-west-3
S3_ACCESS_KEY=inutilise
S3_SECRET_KEY=inutilise-pilote-local
S3_BUCKET_PUBLIC=mambo-proxi-public
S3_BUCKET_PRIVATE=mambo-proxi-private
S3_FORCE_PATH_STYLE=false

# ── E-mails : pas d'envoi réel pour l'instant, tout part dans Mailpit (service interne) ──
# Plus tard (fournisseur SMTP, domaine authentifié SPF/DKIM) : SMTP_HOST=…, SMTP_PORT=587, SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MAMBO Proxi <contact@mamboproxi.com>"

# ── Compte administrateur initial (seed, première mise en place seulement) ──
# Mot de passe long et aléatoire (openssl rand -hex 16), à changer après la première connexion ; peut être retiré du
# fichier ensuite. SEED_DEMO_PASSWORD est interdite en production.
SEED_ADMIN_EMAIL=mireille@mamboproxi.com
SEED_ADMIN_NAME=Mireille Bell
SEED_ADMIN_PASSWORD=

# ── Observabilité (facultatif) ──
SENTRY_DSN=
