# Mandataire inverse du VPS : HTTPS automatique (Let's Encrypt) pour le site et l'API, compression, en-têtes.
# WEB_DOMAIN : mamboproxi.com (www redirigé) ; API_DOMAIN : api.mamboproxi.com.
{
	email {$ACME_EMAIL}
}

# Adresse canonique du site : sans www (= NEXT_PUBLIC_SITE_URL du site, WEB_URL de l'API, seule origine CORS).
www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$WEB_DOMAIN} {
	encode zstd gzip

	# Le site pose ses propres en-têtes de sécurité (CSP comprise, next.config.ts).
	header {
		-Server
		-X-Powered-By
	}

	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip

	# Plus grand envoi accepté par l'API : média de 10 Mo (CV et pièces jointes : 5 Mo), plus l'enveloppe multipart.
	request_body {
		max_size 12MB
	}

	# L'API pose déjà ses en-têtes (Helmet) : valeurs par défaut seulement s'ils manquent.
	header {
		defer
		-Server
		-X-Powered-By
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# X-Forwarded-For posé par Caddy : l'API (trust proxy = 1 en production) en tire l'adresse du visiteur.
	reverse_proxy api:4000
}
