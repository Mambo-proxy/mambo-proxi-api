// Modèle de données de l'API MAMBO Proxi (PostgreSQL).
// Source de vérité des échanges : contracts/openapi.yaml. Documentation : docs/MODELE_DE_DONNEES.md.
//
// Conventions appliquées partout :
// - identifiants `cuid(2)` ; `createdAt` / `updatedAt` en `timestamptz` (UTC) ;
// - tables et colonnes en snake_case (`@@map` / `@map`), champs Prisma en camelCase comme le JSON du contrat ;
// - le français est la langue de référence des colonnes ordinaires. Traductions anglaises (`?lang=en`) :
//   · colonnes `…En` pour les modèles dont le contrat édite déjà les champs `…En` (zones, quartiers, magazine) ;
//   · ailleurs, colonne `translations` (JSON) `{ "en": { "<champ>": <valeur> } }` : recouvrement partiel des
//     champs traduisibles, de même forme que le champ français (y compris les champs JSON structurés). Un champ
//     absent est renvoyé en français, comme le prévoit le contrat. Ce choix évite de doubler une quarantaine de
//     colonnes, dont beaucoup sont déjà des structures JSON (étapes, FAQ, sections de pages), et reste extensible ;
// - aucun prix des prestations n'est stocké (devis uniquement) ;
// - `isDemo` marque les données de démonstration supprimées par `pnpm db:purge-demo`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

